[Unit]
Description=İş Akışı verilerini temizle ve şifreli yedekle

[Service]
Type=oneshot
WorkingDirectory=%h/.local/lib/isakisi
EnvironmentFile=%h/.config/isakisi/service.env
ExecStart=%h/.local/lib/isakisi/.venv/bin/isakisi cleanup
ExecStart=%h/.local/lib/isakisi/.venv/bin/isakisi backup
UMask=0077
